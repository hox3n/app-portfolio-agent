AGENT_DB_PATH=data/portfolio.duckdb
AGENT_EXPORT_DIR=exports

# Sample data generator (make seed)
AGENT_SEED=42
AGENT_SEED_START=2024-01-01
AGENT_SEED_END=2025-01-31

AGENT_LLM_PROVIDER=ollama
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=qwen3.5:4b
# Keep false: thinking mode made qwen3.5 ~200x slower
AGENT_OLLAMA_THINK=false
AGENT_LLM_TEMPERATURE=0
AGENT_LLM_TIMEOUT_S=60
AGENT_LLM_MAX_RETRIES=2

AGENT_MAX_INPUT_CHARS=2000
AGENT_MAX_SQL_CHARS=2000
AGENT_SQL_ROW_LIMIT=100
# Q&A loop: tool calls per question, per LLM turn, and characters of each result shown to the LLM
AGENT_MAX_TOOL_STEPS=6
AGENT_MAX_TOOL_CALLS_PER_STEP=3
AGENT_MAX_TOOL_RESULT_CHARS=6000

AGENT_BUDGET_CUT_ROAS_BELOW=0.8
AGENT_BUDGET_SCALE_ROAS_AT_LEAST=1.5
AGENT_BUDGET_SCALE_MIN_SPEND=1000
AGENT_ANOMALY_MIN_CHANGE_PCT=30
AGENT_ANOMALY_MIN_SPEND=500
AGENT_ANOMALY_DEFAULT_DAYS=7
# JSON list from: installs, ua_cost, revenue, profit, roas, cpi, arpi
AGENT_ANOMALY_METRICS=["installs","ua_cost","revenue","roas","cpi"]

# false = always use the deterministic template summary
AGENT_LLM_SUMMARIES=true
AGENT_MAX_SUMMARY_CHARS=1500
AGENT_SUMMARY_TOP_N=5
AGENT_SUMMARY_MAX_ANOMALIES=10

AGENT_SESSION_MAX_TURNS=10
# Earlier turns shown to the planner for follow-up questions
AGENT_SESSION_HISTORY_TURNS=3
AGENT_SESSION_MAX_SESSIONS=1000

AGENT_DISPLAY_MAX_ROWS=10

AGENT_LOG_LEVEL=INFO
# json | text
AGENT_LOG_FORMAT=json
AGENT_LOG_MAX_VALUE_CHARS=500

# Optional: with a key set, every run is traced to LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=app-portfolio-agent

